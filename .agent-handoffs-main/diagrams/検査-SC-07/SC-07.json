   "actor": "conv",
   "type": "action",
   "label": "保存先を空にする(この端末のサインアウトを呼ぶ。SIGNED_OUTを通知)"
  },
  {
   "id": "p_disp",
   "actor": "proc",
   "type": "decision",
   "label": "見張りはまだ続いているか(解除されていないか)"
  },
  {
   "id": "r_lost",
   "actor": "rule",
   "type": "decision",
   "label": "確かめた結果は未認証か(lostByStatus)"
  },
