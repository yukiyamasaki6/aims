   "id": "c_get",
   "actor": "conv",
   "type": "action",
   "label": "保存先のセッションの読み取りを窓口に頼む(getSession。投げたら不明にする)"
  },
  {
   "id": "a_load",
   "actor": "auth",
   "type": "action",
   "label": "端末の保存先(cookie)からセッションを読む"
  },
  {
   "id": "a_has",
   "actor": "auth",
   "type": "decision",
   "label": "保存先にセッションはあるか"
  },
  {
   "id": "a_exp",
   "actor": "auth",
   "type": "decision",
   "label": "アクセストークンの期限が近い(残り90秒未満)か"
  },
  {
   "id": "a_refresh",
   "actor": "auth",
   "type": "action",
   "label": "更新トークンで、トークンの更新を認証サービスに頼む"
  },
  {
   "id": "s_ref",
   "actor": "srv",
   "type": "action",
   "label": "更新を判定し、新しいトークンか、拒否か、失敗を返す"
  },
  {
   "id": "a_res",
   "actor": "auth",
   "type": "decision",
   "label": "更新の結果は"
  },
  {
   "id": "a_save",
   "actor": "auth",
   "type": "action",
   "label": "新しいセッションを保存先へ書く(TOKEN_REFRESHEDを通知。受け手はSC-06、SC-08、SC-55)"
  },
  {
   "id": "a_valid",
   "actor": "auth",
   "type": "decision",
   "label": "アクセストークンはまだ有効で、保存先のセッションが変わっていないか"
