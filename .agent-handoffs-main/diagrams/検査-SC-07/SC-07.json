  },
  {
   "id": "conv",
   "label": "窓口の変換(supabase-auth.tsの読み取り)"
  },
  {
   "id": "auth",
   "label": "認証サービスの窓口(auth-jsと端末のセッション)"
  },
  {
   "id": "srv",
   "label": "認証サービス(サーバー)"
  },
  {
   "id": "rule",
   "label": "規則(auth-change、session-end-flow、auth-routes)"
  },
  {
   "id": "nav",
   "label": "遷移(ページ全体の読み込み)"
  }
 ],
 "steps": [
  {
   "id": "start",
   "actor": "ent",
   "type": "start",
   "label": "認証が必要な画面((main)配下)が表示される(マウント)"
  },
  {
   "id": "e_watch",
   "actor": "ent",
   "type": "action",
   "label": "表示の間だけ見張りを始める(useEffectでwatch()。通信状態の部品は入口で作って渡してある)"
  },
  {
   "id": "p_sub",
   "actor": "proc",
   "type": "action",
   "label": "認証状態の購読を登録する(発火後の経路はSC-06)"
  },
  {
   "id": "p_on",
   "actor": "proc",
   "type": "action",
   "label": "通信復帰の購読を登録する(戻ったら確認を始める)"
  },
  {
   "id": "n_listen",
   "actor": "ent",
   "type": "action",
   "label": "onlineイベントの待ち受けをwindowに登録する"
  },
  {
   "id": "p_check",
   "actor": "proc",
   "type": "action",
   "label": "確認を始める(check。始めた時と、通信が戻った時)"
  },
  {
   "id": "n_read",
   "actor": "ent",
   "type": "action",
   "label": "通信状態を返す(navigator.onLineがfalseのときだけオフライン)"
  },
  {
   "id": "p_off",
   "actor": "proc",
   "type": "decision",
   "label": "オフラインか"
  },
  {
