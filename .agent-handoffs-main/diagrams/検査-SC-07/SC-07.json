   "actor": "rule",
   "type": "end",
   "label": "移らない(遷移は1回だけ。認証の通知や別の確認が先に移している)"
  },
  {
   "id": "r_mark",
   "actor": "rule",
   "type": "action",
   "label": "遷移を始めた状態にする(left=true)"
  },
  {
   "id": "r_valid",
   "actor": "rule",
   "type": "decision",
   "label": "今の場所は遷移元として有効か(長さ、先頭の//、制御文字、同一オリジン、保護の範囲)"
