   "actor": "ent",
   "type": "decision",
   "label": "移らずに待つ。次に起きるのは"
  },
  {
   "id": "e_unmount",
   "actor": "ent",
   "type": "end",
   "label": "見張りが解除される(アンマウント。解除の中身はSC-12)"
  },
  {
   "id": "p_lose",
   "actor": "proc",
   "type": "action",
   "label": "喪失として、今の場所を遷移元の候補にして、遷移の可否を規則に尋ねる"
  },
