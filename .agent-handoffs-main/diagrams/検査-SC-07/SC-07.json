   "actor": "conv",
   "type": "action",
   "label": "認証済みを返す(利用者ID付き)"
  },
  {
   "id": "c_unauth",
   "actor": "conv",
   "type": "action",
   "label": "未認証を返す"
  },
  {
   "id": "c_unknown",
   "actor": "conv",
   "type": "action",
   "label": "不明を返す(確かめられない)"
  },
  {
