   "actor": "auth",
   "type": "action",
   "label": "更新の結果を捨てる(破棄のエラーを返す。保存先は別の書き手が書いたまま)"
  },
  {
   "id": "a_clear",
   "actor": "auth",
   "type": "action",
   "label": "保存先を空にし、SIGNED_OUTを通知する(見張りの購読者もこの通知で喪失として移ろうとする。SC-06)"
  },
  {
   "id": "a_ret",
   "actor": "auth",
   "type": "action",
   "label": "セッションとエラーを返す"
  },
  {
