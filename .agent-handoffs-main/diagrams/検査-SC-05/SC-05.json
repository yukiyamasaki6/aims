{
  "title": "SC-05 認証が必要な画面・認証専用画面を要求する",
  "actors": [
    {"id": "browser", "label": "ブラウザ(端末。Service Workerを含む)"},
    {"id": "entry", "label": "要求の入口(proxy.ts)"},
    {"id": "session", "label": "セッションの更新(lib/supabase session.ts)"},
    {"id": "rule", "label": "経路の規則(auth-routes.ts、round-routes.ts)"},
    {"id": "authjs", "label": "認証サービスの窓口(@supabase/ssrとauth-js)"},
    {"id": "svc", "label": "認証サービス(サーバー)"}
  ],
  "steps": [
    {"id": "start", "actor": "browser", "type": "start", "label": "ブラウザが/rounds配下、/signin、/signup、/reset-passwordを要求する(ページ移動、RSCの取得、Server Actionの呼び出しのPOSTを含む)"},
    {"id": "d_sw", "actor": "browser", "type": "decision", "label": "Service Workerが枠を返すか(ナビゲーションで、/rounds、/rounds/new、/rounds/<ID>、かつ枠が格納済み。SC-15)"},
    {"id": "e_sw", "actor": "browser", "type": "end", "label": "サーバーへ届かず、端末のキャッシュから枠が返る(未認証の扱いは(main)の見張り=SC-06、SC-07)"},
    {"id": "d_match", "actor": "entry", "type": "decision", "label": "経路がmatcherに一致するか(/signin、/signup、/reset-password、/rounds、/rounds/…)"},
    {"id": "e_nomatch", "actor": "entry", "type": "end", "label": "proxyは実行されず、そのまま配信される(/、/offline、/__shell/*、静的資産、/signin/extra、/roundsxなど)"},
    {"id": "p_call", "actor": "entry", "type": "action", "label": "要求と、規則(redirectFor(r, ROUNDS_PATH)。保護の範囲の根を値で渡す)を渡して、セッションの更新を呼ぶ"},
    {"id": "s_resp", "actor": "session", "type": "action", "label": "進めるための応答を用意する(NextResponse.next)"},
    {"id": "d_env", "actor": "session", "type": "decision", "label": "Supabaseの環境変数(URL、公開キー)が両方あるか"},
    {"id": "e_env", "actor": "session", "type": "end", "label": "例外を投げる(Missing Supabase environment variables)。要求は500になる"},
    {"id": "s_client", "actor": "session", "type": "action", "label": "サーバー用クライアントを作る(cookieの読み取りは要求から、書き込みはsetAllへ)"},
    {"id": "a_getuser", "actor": "authjs", "type": "action", "label": "getUserを呼ぶ: 要求のcookieからセッションを読む"},
    {"id": "d_has", "actor": "authjs", "type": "decision", "label": "cookieにセッションがあるか"},
    {"id": "d_exp", "actor": "authjs", "type": "decision", "label": "アクセストークンの期限が近いか"},
    {"id": "v_refresh", "actor": "svc", "type": "action", "label": "リフレッシュトークンでセッションを更新する(回転)"},
    {"id": "d_refok", "actor": "svc", "type": "decision", "label": "更新できたか"},
    {"id": "a_setall", "actor": "authjs", "type": "action", "label": "新しい値をsetAllへ渡す"},
    {"id": "s_setall", "actor": "session", "type": "action", "label": "要求のcookieへ書き、応答を作り直して、応答のSet-Cookieへ書く"},
    {"id": "v_user", "actor": "svc", "type": "action", "label": "GET /userで、アクセストークンの利用者を問い合わせる"},
    {"id": "d_userok", "actor": "svc", "type": "decision", "label": "利用者が返ったか"},
    {"id": "a_user", "actor": "authjs", "type": "action", "label": "利用者を返す"},
    {"id": "a_null", "actor": "authjs", "type": "action", "label": "利用者なし(null)を返す(セッションなし、更新の失敗、無効・削除済み、サービスへ届かない・5xxを区別しない。エラーは読まない)"},
    {"id": "s_args", "actor": "session", "type": "action", "label": "規則へ渡す値を作る: signedIn(利用者が非null)、pathname、search、isServerAction(next-actionヘッダーの有無)"},
    {"id": "r_sa", "actor": "rule", "type": "decision", "label": "Server Actionの呼び出しか"},
    {"id": "r_unauth", "actor": "rule", "type": "decision", "label": "未認証で、保護の範囲(/roundsとその下)か"},
    {"id": "r_href", "actor": "rule", "type": "action", "label": "pathname+searchを遷移元の候補にして、検証・正規化する(allowedReturnTo: 長さ、形、同一オリジン、保護の範囲)"},
    {"id": "d_valid", "actor": "rule", "type": "decision", "label": "有効で、かつ既定の行き先(/rounds)だけではないか"},
    {"id": "r_with", "actor": "rule", "type": "action", "label": "行き先=/signin?returnTo=<符号化した遷移元>"},
    {"id": "r_plain", "actor": "rule", "type": "action", "label": "行き先=/signin(遷移元なし)"},
    {"id": "r_guest", "actor": "rule", "type": "decision", "label": "認証済みで、未認証専用の画面(/signin、/signup、/reset-password)か"},
    {"id": "r_isin", "actor": "rule", "type": "decision", "label": "経路は/signinか"},
    {"id": "r_read", "actor": "rule", "type": "action", "label": "クエリのreturnToを読み、検証する(readReturnTo)"},
    {"id": "d_ret", "actor": "rule", "type": "decision", "label": "有効な遷移元があるか"},
    {"id": "r_retdest", "actor": "rule", "type": "action", "label": "行き先=遷移元"},
    {"id": "r_defdest", "actor": "rule", "type": "action", "label": "行き先=/rounds(既定の行き先)"},
    {"id": "r_null", "actor": "rule", "type": "action", "label": "行き先なし(null)"},
    {"id": "d_dest", "actor": "session", "type": "decision", "label": "行き先があるか"},
    {"id": "s_redirect", "actor": "session", "type": "action", "label": "リダイレクトの応答を作る(NextResponse.redirect。更新したcookieは付かない)"},
    {"id": "s_pass", "actor": "session", "type": "action", "label": "用意した応答を返す(更新があればSet-Cookie付き)"},
    {"id": "p_ret", "actor": "entry", "type": "action", "label": "セッションの更新の結果を、そのまま応答として返す"},
    {"id": "d_res", "actor": "browser", "type": "decision", "label": "応答はリダイレクトか"},
    {"id": "e_redir", "actor": "browser", "type": "end", "label": "ブラウザが行き先を取得し直す(未認証は遷移元つきの/signin=SC-02へ、認証済みは一覧または遷移元へ)"},
    {"id": "e_ok", "actor": "browser", "type": "end", "label": "要求された画面の枠が配信される(更新があれば端末のcookieが書き換わる)"}
  ],
  "flows": [
    {"from": "start", "to": "d_sw"},
    {"from": "d_sw", "to": "e_sw", "label": "はい"},
    {"from": "d_sw", "to": "d_match", "label": "いいえ"},
    {"from": "d_match", "to": "e_nomatch", "label": "いいえ"},
    {"from": "d_match", "to": "p_call", "label": "はい"},
    {"from": "p_call", "to": "s_resp"},
    {"from": "s_resp", "to": "d_env"},
    {"from": "d_env", "to": "e_env", "label": "いいえ"},
    {"from": "d_env", "to": "s_client", "label": "はい"},
    {"from": "s_client", "to": "a_getuser"},
    {"from": "a_getuser", "to": "d_has"},
    {"from": "d_has", "to": "a_null", "label": "いいえ"},
    {"from": "d_has", "to": "d_exp", "label": "はい"},
    {"from": "d_exp", "to": "v_refresh", "label": "はい"},
    {"from": "d_exp", "to": "v_user", "label": "いいえ"},
    {"from": "v_refresh", "to": "d_refok"},
    {"from": "d_refok", "to": "a_null", "label": "いいえ"},
    {"from": "d_refok", "to": "a_setall", "label": "はい"},
    {"from": "a_setall", "to": "s_setall"},
    {"from": "s_setall", "to": "v_user"},
    {"from": "v_user", "to": "d_userok"},
    {"from": "d_userok", "to": "a_user", "label": "はい"},
    {"from": "d_userok", "to": "a_null", "label": "いいえ"},
    {"from": "a_user", "to": "s_args"},
    {"from": "a_null", "to": "s_args"},
    {"from": "s_args", "to": "r_sa"},
    {"from": "r_sa", "to": "r_null", "label": "はい"},
    {"from": "r_sa", "to": "r_unauth", "label": "いいえ"},
    {"from": "r_unauth", "to": "r_href", "label": "はい"},
    {"from": "r_unauth", "to": "r_guest", "label": "いいえ"},
    {"from": "r_href", "to": "d_valid"},
    {"from": "d_valid", "to": "r_with", "label": "はい"},
    {"from": "d_valid", "to": "r_plain", "label": "いいえ"},
    {"from": "r_guest", "to": "r_isin", "label": "はい"},
    {"from": "r_guest", "to": "r_null", "label": "いいえ"},
    {"from": "r_isin", "to": "r_read", "label": "はい"},
    {"from": "r_isin", "to": "r_defdest", "label": "いいえ(/signup、/reset-password)"},
    {"from": "r_read", "to": "d_ret"},
    {"from": "d_ret", "to": "r_retdest", "label": "はい"},
    {"from": "d_ret", "to": "r_defdest", "label": "いいえ"},
    {"from": "r_with", "to": "d_dest"},
    {"from": "r_plain", "to": "d_dest"},
    {"from": "r_retdest", "to": "d_dest"},
    {"from": "r_defdest", "to": "d_dest"},
    {"from": "r_null", "to": "d_dest"},
    {"from": "d_dest", "to": "s_redirect", "label": "はい"},
    {"from": "d_dest", "to": "s_pass", "label": "いいえ(null)"},
    {"from": "s_redirect", "to": "p_ret"},
    {"from": "s_pass", "to": "p_ret"},
    {"from": "p_ret", "to": "d_res"},
    {"from": "d_res", "to": "e_redir", "label": "はい"},
    {"from": "d_res", "to": "e_ok", "label": "いいえ"}
  ]
}
