{
  "title": "SC-01 サインアップする",
  "actors": [
    {"id": "screen", "label": "画面"},
    {"id": "proc", "label": "サインアップの手続き(規則を含む)"},
    {"id": "reg", "label": "登録の確認(サーバー)"},
    {"id": "auth", "label": "認証サービス(メール・DBを含む)"},
    {"id": "nav", "label": "遷移"}
  ],
  "steps": [
    {"id": "start", "actor": "screen", "type": "start", "label": "利用者が/signupを開く(メール入力の段階)"},
    {"id": "widget", "actor": "screen", "type": "action", "label": "Turnstileの結果(トークン、失効・失敗はnull)を状態に保持する"},
    {"id": "s_email", "actor": "screen", "type": "action", "label": "メールを入力して「認証コードを送信」を押す"},
    {"id": "p_begin1", "actor": "proc", "type": "action", "label": "送信の開始を命じる(描画を待たない最新の状態に適用)"},
    {"id": "d_busy1", "actor": "proc", "type": "decision", "label": "実行中か、段階がメール入力でないか"},
    {"id": "d_email", "actor": "proc", "type": "decision", "label": "メールは正しいか(空・254文字以内・形式)"},
    {"id": "d_cap1", "actor": "proc", "type": "decision", "label": "チェックは完了しているか"},
    {"id": "p_started1", "actor": "proc", "type": "action", "label": "送信中にして、メールとトークンを取り出す"},
    {"id": "p_reg", "actor": "proc", "type": "action", "label": "登録の確認を頼む(トークンは使わない)"},
    {"id": "r_check", "actor": "reg", "type": "action", "label": "管理者の接続で再設定用リンクの生成を試し、利用者の有無と確認済みかを調べる"},
    {"id": "d_reg", "actor": "reg", "type": "decision", "label": "結果は"},
    {"id": "r_registered", "actor": "reg", "type": "action", "label": "確認済みの利用者がいる: 登録済みを返す"},
    {"id": "r_none", "actor": "reg", "type": "action", "label": "利用者がいない、または未確認: 未登録を返す"},
    {"id": "r_unknown", "actor": "reg", "type": "action", "label": "それ以外のエラー、または投げた: 確かめられなかったとして投げる"},
    {"id": "d_mount1", "actor": "proc", "type": "decision", "label": "画面はまだ表示中か"},
    {"id": "d_regres", "actor": "proc", "type": "decision", "label": "確認の結果は"},
    {"id": "p_failed_reg", "actor": "proc", "type": "action", "label": "failedを送る(登録済み、または通信エラー。トークンは未使用なので保持)"},
    {"id": "s_show_reg", "actor": "screen", "type": "action", "label": "失敗の文言を表示し、送信中を解除する"},
    {"id": "p_send", "actor": "proc", "type": "action", "label": "認証コードの送付を頼む(目的はサインアップ、メール、トークン)"},
    {"id": "a_otp", "actor": "auth", "type": "action", "label": "接続を得て、signInWithOtpをトークン付きで呼ぶ"},
    {"id": "d_svc1", "actor": "auth", "type": "decision", "label": "応答は"},
    {"id": "a_ok1", "actor": "auth", "type": "action", "label": "未確認の利用者を作り(新規のとき)、トリガーでusersに行ができ、コードのメールを送る。受け付けられたを返す"},
    {"id": "a_unreach1", "actor": "auth", "type": "action", "label": "届かなかったを返す(呼び出しが投げた、接続を得られない)"},
    {"id": "a_reject1", "actor": "auth", "type": "action", "label": "通信の断なら届かなかった、他は種類へ写し(未知はother)、拒否されたを返す"},
    {"id": "d_mount2", "actor": "proc", "type": "decision", "label": "画面はまだ表示中か"},
    {"id": "d_res1", "actor": "proc", "type": "decision", "label": "結果は"},
    {"id": "p_failed1", "actor": "proc", "type": "action", "label": "failedを送る(トークンは未使用なので保持)"},
    {"id": "s_show_failed1", "actor": "screen", "type": "action", "label": "通信エラーを表示し、実行中を解除する"},
    {"id": "p_refused1", "actor": "proc", "type": "action", "label": "refusedを送る(トークンは使用済みなので消費)"},
    {"id": "s_show_refused1", "actor": "screen", "type": "action", "label": "失敗の文言を表示し、実行中を解除する"},
    {"id": "s_reset1", "actor": "screen", "type": "action", "label": "Turnstileをやり直す"},
    {"id": "d_which", "actor": "proc", "type": "decision", "label": "初回の送付か、再送か"},
    {"id": "p_sent", "actor": "proc", "type": "action", "label": "codeSentを送る(コード入力の段階へ。トークン消費、再送の待ち60秒)"},
    {"id": "p_resent", "actor": "proc", "type": "action", "label": "codeResentを送る(段階は変えない。トークン消費)"},
    {"id": "s_reset2", "actor": "screen", "type": "action", "label": "Turnstileをやり直す(再送用の新しいトークン)"},
    {"id": "s_code", "actor": "screen", "type": "action", "label": "コード入力の画面を表示し、再送の待ちを1秒ごとに減らす"},
    {"id": "d_op", "actor": "screen", "type": "decision", "label": "利用者の操作は"},

    {"id": "s_verify", "actor": "screen", "type": "action", "label": "メールのコードを入力して「確認」を押す"},
    {"id": "p_begin2", "actor": "proc", "type": "action", "label": "確認の開始を命じる"},
    {"id": "d_busy2", "actor": "proc", "type": "decision", "label": "実行中か、段階がコード入力でないか"},
    {"id": "d_code", "actor": "proc", "type": "decision", "label": "コードは6桁の数字か"},
    {"id": "p_started2", "actor": "proc", "type": "action", "label": "確認中にして、メールとコードを取り出す"},
    {"id": "a_verify", "actor": "auth", "type": "action", "label": "接続を得て、verifyOtpを呼ぶ"},
    {"id": "d_svc2", "actor": "auth", "type": "decision", "label": "応答は"},
    {"id": "a_ok2", "actor": "auth", "type": "action", "label": "メールが確認され、端末にセッションが保存される。受け付けられたを返す"},
    {"id": "a_unreach2", "actor": "auth", "type": "action", "label": "届かなかったを返す(呼び出しが投げた)"},
    {"id": "a_reject2", "actor": "auth", "type": "action", "label": "通信の断なら届かなかった、期限切れ・誤りは種類へ写し、拒否されたを返す"},
    {"id": "d_mount3", "actor": "proc", "type": "decision", "label": "画面はまだ表示中か"},
    {"id": "d_res2", "actor": "proc", "type": "decision", "label": "結果は(届かなかった・拒否は同じ失敗にまとめる)"},
    {"id": "p_failed2", "actor": "proc", "type": "action", "label": "failedを送る(種類つき)"},
    {"id": "s_show_failed2", "actor": "screen", "type": "action", "label": "失敗の文言を表示し、実行中を解除する"},
    {"id": "p_confirmed", "actor": "proc", "type": "action", "label": "codeConfirmedを送る(パスワード設定の段階へ)"},

    {"id": "s_resend", "actor": "screen", "type": "action", "label": "「再送」を押す"},
    {"id": "p_begin3", "actor": "proc", "type": "action", "label": "再送の開始を命じる"},
    {"id": "d_busy3", "actor": "proc", "type": "decision", "label": "実行中か、段階がコード入力でないか"},
    {"id": "d_wait", "actor": "proc", "type": "decision", "label": "再送の待ちは残っていないか"},
    {"id": "d_cap2", "actor": "proc", "type": "decision", "label": "チェックは完了しているか"},
    {"id": "p_started3", "actor": "proc", "type": "action", "label": "再送中にして、再送の待ちを60秒に戻す(結果を待たずに)。登録の確認はしない"},

    {"id": "s_back", "actor": "screen", "type": "action", "label": "「戻る」を押す"},
    {"id": "d_back", "actor": "proc", "type": "decision", "label": "実行中の操作があるか"},
    {"id": "p_backed", "actor": "proc", "type": "action", "label": "emailStepReturnedを送る(メール入力の段階へ。メールは保持、トークンとエラーを消去)"},

    {"id": "s_pwview", "actor": "screen", "type": "action", "label": "パスワード設定の画面を表示する"},
    {"id": "s_pw", "actor": "screen", "type": "action", "label": "パスワードを入力して(表示を切り替えられる)「登録してサインイン」を押す"},
    {"id": "p_begin4", "actor": "proc", "type": "action", "label": "設定の開始を命じる"},
    {"id": "d_busy4", "actor": "proc", "type": "decision", "label": "実行中か、段階がパスワード設定でないか"},
    {"id": "d_pw", "actor": "proc", "type": "decision", "label": "パスワードは規則に合うか(空でない・8〜72文字・半角英数記号・英字と数字)"},
    {"id": "p_started4", "actor": "proc", "type": "action", "label": "設定中にして、パスワードを取り出す"},
    {"id": "a_update", "actor": "auth", "type": "action", "label": "接続を得て、updateUserをパスワード付きで呼ぶ"},
    {"id": "d_svc3", "actor": "auth", "type": "decision", "label": "応答は"},
    {"id": "a_ok3", "actor": "auth", "type": "action", "label": "パスワードが設定される(サインイン状態のまま)。受け付けられたを返す"},
    {"id": "a_unreach3", "actor": "auth", "type": "action", "label": "届かなかったを返す(呼び出しが投げた)"},
    {"id": "a_reject3", "actor": "auth", "type": "action", "label": "通信の断なら届かなかった、弱いパスワードなどは種類へ写し、拒否されたを返す"},
    {"id": "d_mount4", "actor": "proc", "type": "decision", "label": "画面はまだ表示中か"},
    {"id": "d_res3", "actor": "proc", "type": "decision", "label": "結果は(届かなかった・拒否は同じ失敗にまとめる)"},
    {"id": "p_failed3", "actor": "proc", "type": "action", "label": "failedを送る(種類つき)"},
    {"id": "s_show_failed3", "actor": "screen", "type": "action", "label": "失敗の文言を表示し、実行中を解除する"},
    {"id": "d_mount5", "actor": "proc", "type": "decision", "label": "画面はまだ表示中か(遷移の直前に再確認)"},
    {"id": "p_set", "actor": "proc", "type": "action", "label": "passwordSetを送る(以前のエラーを消す。設定中は維持)"},
    {"id": "p_dest", "actor": "proc", "type": "action", "label": "既定の行き先(/rounds)を決める(遷移元は使わない)"},
    {"id": "n_push", "actor": "nav", "type": "action", "label": "routerで/roundsへ進む"},
    {"id": "d_nav", "actor": "nav", "type": "decision", "label": "遷移は投げなかったか"},
    {"id": "p_failed_nav", "actor": "proc", "type": "action", "label": "通信エラーとしてfailedを送る"},
    {"id": "e_ok", "actor": "nav", "type": "end", "label": "一覧の画面へ移る(設定中のまま)。アカウントと端末のセッションができている"},

    {"id": "s_invalid", "actor": "screen", "type": "action", "label": "最初の1件をその欄に表示する(送信は欄ごと、再送は再送の欄)"},
    {"id": "e_invalid", "actor": "screen", "type": "end", "label": "認証せず終了(同じ段階で再操作できる)"},
    {"id": "e_busy", "actor": "proc", "type": "end", "label": "何もしない(重複させない)"},
    {"id": "e_left", "actor": "proc", "type": "end", "label": "状態を変えず、次へ進まない(送らない・遷移しない)"},
    {"id": "e_retry", "actor": "screen", "type": "end", "label": "同じ段階から再試行できる(トークンは保持)"},
    {"id": "e_refused", "actor": "screen", "type": "end", "label": "同じ段階で、新しいトークンで再操作できる"},
    {"id": "e_nothing", "actor": "proc", "type": "end", "label": "戻らず、そのまま(操作中は戻らない)"}
