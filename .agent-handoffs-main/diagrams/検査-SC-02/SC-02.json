{
  "title": "SC-02 ログインする",
  "actors": [
    {"id": "screen", "label": "画面"},
    {"id": "proc", "label": "サインインの手続き"},
    {"id": "auth", "label": "認証サービス"},
    {"id": "nav", "label": "遷移"}
  ],
  "steps": [
    {"id": "start", "actor": "screen", "type": "start", "label": "利用者が/signinを開く"},
    {"id": "widget", "actor": "screen", "type": "action", "label": "Turnstileの結果(トークン、失効・失敗はnull)を状態に保持する"},
    {"id": "submit", "actor": "screen", "type": "action", "label": "メールとパスワードを入力して送信する"},
    {"id": "begin", "actor": "proc", "type": "action", "label": "開始を命じる(描画を待たない最新の状態に適用)"},
    {"id": "d_busy", "actor": "proc", "type": "decision", "label": "送信中か"},
    {"id": "e_busy", "actor": "proc", "type": "end", "label": "何もしない(照合しない)"},
    {"id": "d_email", "actor": "proc", "type": "decision", "label": "メールは正しいか(空・形式・254文字以内)"},
    {"id": "d_pw", "actor": "proc", "type": "decision", "label": "パスワードは入力されているか(強さは問わない)"},
    {"id": "d_cap", "actor": "proc", "type": "decision", "label": "チェックは完了しているか"},
    {"id": "show_invalid", "actor": "screen", "type": "action", "label": "最初の1件を欄に表示する(上部の理由は消す)"},
    {"id": "e_invalid", "actor": "screen", "type": "end", "label": "認証せず終了(再送信できる)"},
    {"id": "started", "actor": "proc", "type": "action", "label": "送信中にして、トークン付きの資格情報を作る"},
    {"id": "ask", "actor": "proc", "type": "action", "label": "認証サービスに照合を頼む"},
    {"id": "call", "actor": "auth", "type": "action", "label": "接続を得て、signInWithPasswordをトークン付きで呼ぶ"},
    {"id": "d_svc", "actor": "auth", "type": "decision", "label": "応答は"},
    {"id": "a_session", "actor": "auth", "type": "action", "label": "端末にセッションが保存され、受け付けられたを返す"},
    {"id": "a_unreach", "actor": "auth", "type": "action", "label": "届かなかったを返す(呼び出しが投げた、接続を得られない)"},
    {"id": "a_reject", "actor": "auth", "type": "action", "label": "通信の断なら届かなかった、コードは種類へ写し(未知はother)、拒否されたを返す"},
    {"id": "d_mounted", "actor": "proc", "type": "decision", "label": "画面はまだ表示中か"},
    {"id": "e_left", "actor": "proc", "type": "end", "label": "状態を変えず、遷移もしない"},
    {"id": "d_result", "actor": "proc", "type": "decision", "label": "結果は"},
    {"id": "failed", "actor": "proc", "type": "action", "label": "failedを送る(トークンは未使用なので保持)"},
    {"id": "show_failed", "actor": "screen", "type": "action", "label": "通信エラーを表示し、送信中を解除する"},
    {"id": "e_failed", "actor": "screen", "type": "end", "label": "同じトークンで再送信できる"},
    {"id": "refused", "actor": "proc", "type": "action", "label": "refusedを送る(トークンは使用済みなので消費)"},
    {"id": "show_refused", "actor": "screen", "type": "action", "label": "失敗の文言を表示し、送信中を解除する"},
    {"id": "reset", "actor": "screen", "type": "action", "label": "Turnstileをやり直す"},
    {"id": "e_refused", "actor": "screen", "type": "end", "label": "新しいトークンで再送信できる"},
    {"id": "signed", "actor": "proc", "type": "action", "label": "signedInを送る(以前のエラーを消す。送信中は維持)"},
    {"id": "read", "actor": "nav", "type": "action", "label": "URLのクエリreturnToを読む(検証しない)"},
    {"id": "dest", "actor": "proc", "type": "action", "label": "/rounds配下の同一オリジンの値だけ許し、それ以外は/roundsを行き先にする"},
    {"id": "push", "actor": "nav", "type": "action", "label": "routerで行き先へ進む"},
    {"id": "d_nav", "actor": "nav", "type": "decision", "label": "読み出しと遷移は投げなかったか"},
    {"id": "e_ok", "actor": "nav", "type": "end", "label": "行き先の画面へ移る(送信中のまま)"},
    {"id": "refuse_nav", "actor": "proc", "type": "action", "label": "届かなかった失敗としてrefusedを送る"}
  ],
  "flows": [
    {"from": "start", "to": "widget"},
    {"from": "widget", "to": "submit"},
    {"from": "submit", "to": "begin"},
    {"from": "begin", "to": "d_busy"},
    {"from": "d_busy", "to": "e_busy", "label": "送信中"},
    {"from": "d_busy", "to": "d_email", "label": "送信中でない"},
    {"from": "d_email", "to": "show_invalid", "label": "誤り"},
    {"from": "d_email", "to": "d_pw", "label": "正しい"},
    {"from": "d_pw", "to": "show_invalid", "label": "空"},
    {"from": "d_pw", "to": "d_cap", "label": "入力済み"},
    {"from": "d_cap", "to": "show_invalid", "label": "未完了"},
    {"from": "d_cap", "to": "started", "label": "完了"},
    {"from": "show_invalid", "to": "e_invalid"},
    {"from": "started", "to": "ask"},
    {"from": "ask", "to": "call"},
    {"from": "call", "to": "d_svc"},
    {"from": "d_svc", "to": "a_session", "label": "成功"},
    {"from": "d_svc", "to": "a_unreach", "label": "投げた"},
    {"from": "d_svc", "to": "a_reject", "label": "エラーが値で返った"},
    {"from": "a_session", "to": "d_mounted"},
    {"from": "a_unreach", "to": "d_mounted"},
    {"from": "a_reject", "to": "d_mounted"},
    {"from": "d_mounted", "to": "e_left", "label": "離れた"},
    {"from": "d_mounted", "to": "d_result", "label": "表示中"},
    {"from": "d_result", "to": "failed", "label": "届かなかった"},
    {"from": "d_result", "to": "refused", "label": "拒否された"},
    {"from": "d_result", "to": "signed", "label": "受け付けられた"},
    {"from": "failed", "to": "show_failed"},
    {"from": "show_failed", "to": "e_failed"},
    {"from": "refused", "to": "show_refused"},
    {"from": "show_refused", "to": "reset"},
    {"from": "reset", "to": "e_refused"},
    {"from": "signed", "to": "read"},
    {"from": "read", "to": "dest"},
    {"from": "dest", "to": "push"},
    {"from": "push", "to": "d_nav"},
    {"from": "d_nav", "to": "e_ok", "label": "成功"},
    {"from": "d_nav", "to": "refuse_nav", "label": "投げた"},
    {"from": "refuse_nav", "to": "show_refused"}
  ]
}
