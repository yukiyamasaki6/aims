{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 50, "skipBlankLines": true }
        }
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": [
                  "camelCase",
                  "snake_case",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "snake_case"]
              },
              {
                "selector": { "kind": "functionParameter" },
                "formats": ["camelCase"]
              }
            ]
          }
        }
      },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.*",
        "**/*.spec.*",
        "apps/web/tests/**",
        "**/*-test-helpers.ts",
        "apps/web/vitest.setup.mts"
      ],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" }
        }
      }
    },
    {
      "includes": ["apps/web/src/types/supabase.ts"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/*/domain/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["**", "!./**", "!@/routes", "!@/types/supabase"] }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "domainは環境のグローバルを参照しない",
                  "document": "domainは環境のグローバルを参照しない",
                  "localStorage": "domainは環境のグローバルを参照しない",
                  "sessionStorage": "domainは環境のグローバルを参照しない",
                  "indexedDB": "domainは環境のグローバルを参照しない",
                  "navigator": "domainは環境のグローバルを参照しない",
                  "location": "domainは環境のグローバルを参照しない",
                  "fetch": "domainは環境のグローバルを参照しない",
                  "process": "domainは環境のグローバルを参照しない",
                  "crypto": "domainは環境のグローバルを参照しない"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/*/application/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!./**",
                      "!../domain/**",
                      "!@/lib/*/contract/**",
                      "!@/routes",
                      "!@/features/*"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/*/ui/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../infrastructure/**",
                      "@/features/**",
                      "@/lib/*/**",
                      "@/types/**",
                      "@/app/**",
                      "@/i18n/**",
                      "@supabase/**",
                      "idb",
                      "serwist",
                      "@serwist/**",
                      "next/server",
                      "next/headers"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/*/infrastructure/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../ui/**",
                      "@/features/*/**",
                      "@/lib/*/infrastructure/**",
                      "@/components/**",
                      "@/routes",
                      "@/hooks/**",
                      "@/app/**",
                      "@/i18n/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/**",
        "apps/web/src/hooks/**",
        "apps/web/src/lib/utils.ts",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/lib/*/**",
                      "@/types/**",
                      "@/app/**",
                      "@/i18n/**",
                      "@supabase/**",
                      "idb",
                      "serwist",
                      "@serwist/**",
                      "next/server",
                      "next/headers"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/lib/*/contract/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["**", "!./**", "!../../*/contract/**"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/lib/*/infrastructure/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-test-helpers.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/components/**",
                      "@/routes",
                      "@/hooks/**",
                      "@/app/**",
                      "@/i18n/**",
                      "@/lib/*/infrastructure/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
