# Supabase Local Development Defaults
NEXT_PUBLIC_SUPABASE_URL="`supabase status`のAPIs欄のProject URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="`supabase status`のAuthentication Keys欄のPublishable"
SUPABASE_SECRET_KEY="`supabase status`のAuthentication Keys欄のSecret"

# SSH経由でリモートの開発環境にアクセスする場合のみ"true"にする。
USE_SUPABASE_LOCAL_PROXY="false"

# Cloudflare Turnstileのサイトキー。
# 値はローカル開発/プレビュー用のCloudflare公式テストキー（常に検証を通過する）。
# 本番ではVercelの環境変数で実際のSite Keyに上書きする。
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
